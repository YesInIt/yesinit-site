---
# =============================================================================
#  Секреты для роли backup (S3 в Cloud.ru).
#
#  Скопируйте этот файл в group_vars/vault.yml и заполните реальными
#  значениями. group_vars/vault.yml — в .gitignore, в git не попадает.
#
#  Где взять:
#    1. console.cloud.ru → Хранение данных → Object Storage →
#       создать бакет (например, yesinit-tech-backups), доступ Private.
#    2. Там же → "Параметры работы с API" — там указан tenant_id.
#    3. Правый верхний угол → профиль → "Мои учётные данные" → вкладка
#       "Ключи доступа" → Создать ключ доступа → сохраните Key ID и Key
#       Secret (Key Secret показывается только один раз).
# =============================================================================

# Название бакета, который вы создали в Object Storage.
backup_s3_bucket: yesinit-backup

# Access Key ID для S3 API — это НЕ просто Key ID, а связка
# "<tenant_id>:<key_id>" (или "<tenant_id>.<key_id>" — см. документацию
# Cloud.ru), tenant_id смотрите в разделе "Параметры работы с API".
backup_s3_access_key: "<tenant_id>:<key_id>"

# Key Secret из того же места, где создавали ключ доступа.
backup_s3_secret_key: "<key_secret>"
